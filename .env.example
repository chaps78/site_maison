# Copier ce fichier en .env (jamais versionné) puis adapter les valeurs.
#   cp .env.example .env
#
# Pas de commentaire en fin de ligne : docker compose le garderait dans la valeur.
# Un .env de production doit avoir DEBUG=False et une vraie SECRET_KEY
# (l'appli refuse de démarrer en production avec la clé d'exemple).

# ---------- Django ----------
DEBUG=True
# Générer une clé :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-dev-only
# Liste séparée par des virgules. En production : le nom d'hôte Tailscale.
ALLOWED_HOSTS=localhost,127.0.0.1
# Obligatoire en HTTPS derrière nginx (schéma inclus), ex. https://machine.tailnet-xxxx.ts.net
CSRF_TRUSTED_ORIGINS=

# ---------- Docker / nginx (production) ----------
# Nom d'hôte Tailscale complet de la machine (sortie de `tailscale status`).
TAILSCALE_HOSTNAME=machine.tailnet-xxxx.ts.net
# Dossier de l'hôte contenant <TAILSCALE_HOSTNAME>.crt et <TAILSCALE_HOSTNAME>.key
# (générés par `tailscale cert`). Monté en lecture seule dans nginx.
CERTS_DIR=/etc/ssl/tailscale
# Adresse sur laquelle nginx écoute. 0.0.0.0 = toutes les interfaces (LAN inclus).
# Pour n'exposer que Tailscale, mettre l'IP 100.x.y.z de la machine (`tailscale ip -4`).
BIND_ADDRESS=0.0.0.0
# UID/GID de l'utilisateur de l'hôte (`id -u` / `id -g`) : le conteneur écrit dans
# data/ et media/, qui appartiennent à cet utilisateur.
APP_UID=1000
APP_GID=1000
